<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.telemetry.weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>cd /Users/nicolaweiroster/Desktop/Github_repos && mkdir -p logs && { echo \"[$(date '+%Y-%m-%d %H:%M:%S')] Starting update\"; python3 /Users/nicolaweiroster/Desktop/Github_repos/update_telemetry_free.py /Users/nicolaweiroster/Desktop/Github_repos/quantum_platform_telemetry_model_free_v2.xlsx; echo \"[exit_code=$?]\"; } >> /Users/nicolaweiroster/Desktop/Github_repos/logs/update_telemetry.log 2&gt;&amp;1</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/nicolaweiroster/Desktop/Github_repos</string>

    <!-- Weekly run: Monday 08:00 local time. One-off test run at 2026-02-26 22:41. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <!-- macOS weekday: 1=Sunday, 2=Monday, ... 7=Saturday -->
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <!-- One-off run to verify scheduling soon -->
            <key>Year</key>
            <integer>2026</integer>
            <key>Month</key>
            <integer>2</integer>
            <key>Day</key>
            <integer>26</integer>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>51</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/nicolaweiroster/Desktop/Github_repos/logs/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/nicolaweiroster/Desktop/Github_repos/logs/launchd.err</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
